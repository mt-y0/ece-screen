# Copy to .env and adjust. Loaded by the systemd unit (deploy/ece-screen.service);
# for manual runs: `set -a; . ./.env; set +a; make run`.

# Target frame rate (positive integer, default 60)
FPS=60

# UI scale factor (number > 0, default 1.0)
ZOOM=1.0

# raylib log verbosity: unset = warnings only, info = every file load, debug = everything
#RL_LOG=info
